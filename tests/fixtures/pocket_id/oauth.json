{
  "issuer_metadata": {
    "issuer": "https://id.example.test",
    "authorization_endpoint": "https://id.example.test/authorize",
    "token_endpoint": "https://id.example.test/api/oidc/token",
    "jwks_uri": "https://id.example.test/.well-known/jwks.json",
    "response_types_supported": ["code"],
    "grant_types_supported": ["authorization_code", "refresh_token", "client_credentials"],
    "code_challenge_methods_supported": ["S256"],
    "id_token_signing_alg_values_supported": ["RS256"],
    "scopes_supported": ["openid", "profile", "email", "groups", "offline_access"],
    "client_id_metadata_document_supported": true
  },
  "cases": [
    {
      "name": "human-api-access",
      "claims": {"sub": "user-123", "scope": "mcp:connect mcp:tools.read"},
      "allowed": true,
      "reason_code": "oauth.allowed"
    },
    {
      "name": "automation-api-access",
      "claims": {"sub": "client-agent-client", "scope": "mcp:connect mcp:tools.read"},
      "allowed": true,
      "reason_code": "oauth.allowed"
    },
    {
      "name": "wrong-api-audience",
      "claims": {"aud": "https://another-api.example.test", "scope": "mcp:connect mcp:tools.read"},
      "allowed": false,
      "reason_code": "oauth.invalid_token"
    },
    {
      "name": "id-token-is-not-api-access",
      "typ": "JWT",
      "claims": {"aud": "agent-client", "nonce": "login-nonce", "groups": ["admins"]},
      "allowed": false,
      "reason_code": "oauth.invalid_token"
    },
    {
      "name": "missing-connect-permission",
      "claims": {"scope": "mcp:tools.read"},
      "allowed": false,
      "reason_code": "oauth.insufficient_scope"
    },
    {
      "name": "missing-tools-permission",
      "claims": {"scope": "mcp:connect"},
      "allowed": false,
      "reason_code": "oauth.scope_map_denied"
    },
    {
      "name": "expired-access-token",
      "expires_in": -3600,
      "claims": {"scope": "mcp:connect mcp:tools.read"},
      "allowed": false,
      "reason_code": "oauth.invalid_token"
    },
    {
      "name": "wrong-issuer",
      "claims": {"iss": "https://other-id.example.test", "scope": "mcp:connect mcp:tools.read"},
      "allowed": false,
      "reason_code": "oauth.invalid_token"
    }
  ]
}
